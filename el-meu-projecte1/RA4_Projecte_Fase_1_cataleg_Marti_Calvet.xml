-->
<!ELEMENT botiga (dades_botiga, contacte, metodes_pagament, nota_preus, cataleg)>
<!ATTLIST botiga
    xml:lang CDATA #FIXED "ca"
    moneda (EUR | USD ) #REQUIRED
    darrera_actualitzacio CDATA #IMPLIED
>

<!ELEMENT dades_botiga (nom, ubicacio_seu, slogan?)>
