<!ELEMENT nota_preus (#PCDATA)>

<!ELEMENT cataleg (producte+)>
<!ELEMENT producte (nom, categories, especificacions, preu, valoracio?, estoc, data_incorporacio, descripcio)>
<!ATTLIST producte
    codi ID #REQUIRED
    relacionats IDREFS #IMPLIED
    estat (disponible | esgotat) "disponible"
>

<!ELEMENT categories (categoria+)>
<!ELEMENT categoria (#PCDATA)>
<!ELEMENT especificacions (especificacio+)>
<!ELEMENT especificacio (#PCDATA)>
<!ATTLIST especificacio
    nom CDATA #REQUIRED
>
<!ELEMENT preu (#PCDATA)>
<!ELEMENT valoracio (#PCDATA)>
<!ATTLIST valoracio escala CDATA #FIXED "1-5">
<!ELEMENT estoc (#PCDATA)>
<!ELEMENT data_incorporacio (#PCDATA)>
<!ELEMENT descripcio (#PCDATA)>

<!-- Entitats pròpies: text reutilitzable que s'expandeix en llegir el document XML. -->
